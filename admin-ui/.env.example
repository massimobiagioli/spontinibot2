# Admin API key sent as the X-Admin-Key header on every /admin/api request.
# Falls back to "dev-key" in code, matching backend's Config::from_env default.
VITE_ADMIN_API_KEY=dev-key

# Backend base URL used only by the vite dev-server proxy (npm run dev).
# The built/containerized app is proxied by nginx.conf instead.
VITE_BACKEND_URL=http://localhost:8080

# Name of the single persona managed by the Imprinting section. Spontini is a
# single-bot system (Constitution §2), so the UI targets one fixed name.
VITE_PERSONA_NAME=gaspare
