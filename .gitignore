# ─────────────────────────────────────────────────────────────
# Spontini Bot 2 — Root .gitignore
# Rust workspace + Vue frontend + Dockerized local LLM stack
# ─────────────────────────────────────────────────────────────

# ── Rust / Cargo ────────────────────────────────────────────
**/target/
**/*.rs.bk

# ── Node / Vue / Vite ──────────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/
**/coverage/
**/*.local

# Node / npm / pnpm / yarn artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Frontend env files (keep .env.example tracked)
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Environment & secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
secrets/
secrets.txt

# ── Local data & databases ─────────────────────────────────
# kb.db is a runtime artifact mounted on a Docker volume — never commit
*.db
*.db-*
*.sqlite
*.sqlite-*
kb.db
/data/
**/data/

# kb-data volume snapshots (make eject-data / make use-data)
.data/

# ── Models (GGUF files — large, downloaded at provisioning time) ─
# Only the model binaries are excluded — models/*/README.md is tracked
# documentation (see AGENTS.md §4).
**/models/**/*.gguf

# ── Docker / runtime ────────────────────────────────────────
docker-compose.override.yml
.docker/

# ── Logs & tmp ──────────────────────────────────────────────
*.log
logs/
tmp/
*.tmp

# ── Editor / IDE ────────────────────────────────────────────
.idea/
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── OS junk ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
ehthumbs.db
desktop.ini

# ── Test / coverage artifacts ───────────────────────────────
**/tarpaulin-report.html
**/cobertura.xml
**/lcov.info
**/*.profraw
**/*.profdata

# ── Build outputs (misc) ────────────────────────────────────
build/
out/
*.tar
*.zip

# -- OhMyOpencode / Sisyphus artifacts (local LLM stack) ─────────────
.sisyphus/

# TEST
.project/test-ingestion-results
.project/test-reports